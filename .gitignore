# Cargo build output (about 2 GB, regenerated by `cargo build`)
/target/

# Screenshots and dumps made by `frost.exe --snapshot` (regenerable)
/preview*.png
/preview*.txt

# Debug symbols and linker/compiler intermediates
*.pdb
*.rlib
*.rmeta
*.o
*.obj

# Editor and IDE files
.vscode/
.idea/
*.swp
*~

# Local Claude settings
.claude/settings.local.json

# Windows and logs
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.log
*.tmp

# Local secrets
.env

# Note: dist/ (release installers) and Cargo.lock are intentionally NOT ignored.
